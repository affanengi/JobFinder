# ==============================================================================
# Personal AI Job Agent (jobFinder) — Environment Configuration ($0 Free Stack)
# ==============================================================================

# Backend API Configuration
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Google Gemini AI (Free Tier API Keys from Google AI Studio: https://aistudio.google.com)
# Key 1: Master Profile & Parser
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Key 2: Dedicated key for ATS Resume Generation & Studio
RESUME_GEMINI_API_KEY=your_resume_gemini_api_key_here

# Application-owned default Gemini credential for ATS Scanner
SCANNER_GEMINI_API_KEY=

# Key 4: Dedicated key for ATS Custom Question Co-Pilot
QA_COPILOT_GEMINI_API_KEY=your_qa_copilot_gemini_api_key_here

# Key 5: Dedicated key for Company Analysis & Scam Shield (Agent Reach result analysis)
GEMINI_COMPANY_ANALYSIS_API_KEY=your_company_analysis_gemini_api_key_here

# Optional Search Providers for Phase 2 Contact Discovery (Free Tier / Credits Only)
# If empty, automatically degrades to pre-formatted browser search links ($0 free fallback)
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=

# Firebase Configuration (Free Spark Plan)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Playwright Browser Automation (Local Chromium)
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT_MS=30000

# ==============================================================================
# Google Third-Party Connections ($0 Google Cloud OAuth 2.0 Web Applications)
# ==============================================================================
# Dedicated secret for OAuth tokens at rest and HMAC state signing.
# MUST be distinct from AI_ENCRYPTION_SECRET and at least 32 characters.
# Generate locally using: openssl rand -hex 32
OAUTH_ENCRYPTION_SECRET=
GOOGLE_OAUTH_REDIRECT_URI_BASE=http://localhost:8000

# 1. Google Gmail OAuth Client (Separate Web Application credential)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# 2. Google Calendar OAuth Client (Separate Web Application credential)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# 3. Google Drive OAuth Client (Separate Web Application credential)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Legacy Gmail OAuth Fallback (Maintained for backward compatibility)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback


