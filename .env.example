# ==============================================================================
# Personal AI Job Agent (jobFinder) — Environment Configuration ($0 Free Stack)
# ==============================================================================

# Backend API Configuration
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Google Gemini AI (Free Tier API Keys from Google AI Studio: https://aistudio.google.com)
# Key 1: Master Profile & Parser
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Key 2: Dedicated key for ATS Resume Generation & Studio
RESUME_GEMINI_API_KEY=your_resume_gemini_api_key_here

# Key 3: Dedicated key for ATS Scanner & Grounded Bullet Rewrites
SCANNER_GEMINI_API_KEY=your_scanner_gemini_api_key_here

# Key 4: Dedicated key for ATS Custom Question Co-Pilot
QA_COPILOT_GEMINI_API_KEY=your_qa_copilot_gemini_api_key_here

# Firebase Configuration (Free Spark Plan)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Playwright Browser Automation (Local Chromium)
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT_MS=30000
